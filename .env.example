# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TMDB_READ_ACCESS_TOKEN: TMDB v3 API Read Access Token (Bearer JWT) for authenticated metadata & /3/configuration.
TMDB_READ_ACCESS_TOKEN=""

# TMDB_API_KEY: Optional TMDB v3 API key fallback for server-side catalog & search requests.
TMDB_API_KEY=""

# MEDIA_CDN_BASE_URL: Optional CDN/R2/S3 base URL for auto-resolving {tmdbId}.mp4 or master.m3u8 streams.
MEDIA_CDN_BASE_URL=""

# JELLYFIN_URL: Optional Jellyfin server base URL for native direct HLS/MP4 playback (server-side only).
JELLYFIN_URL=""

# JELLYFIN_API_KEY: Optional Jellyfin server API key (kept strictly server-side).
JELLYFIN_API_KEY=""

