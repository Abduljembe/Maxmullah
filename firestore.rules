rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'activeProfileId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'activeProfileId', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.activeProfileId is string && isValidId(data.activeProfileId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidViewerProfile(data, userId, profileId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'avatar', 'avatarColor', 'isKids',
          'favoriteGenres', 'preferredPlatforms', 'watchlist', 'liked', 'disliked',
          'watchHistory', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'avatar', 'avatarColor', 'isKids',
          'favoriteGenres', 'preferredPlatforms', 'watchlist', 'liked', 'disliked',
          'watchHistory', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == profileId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 50
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 8
        && data.avatarColor is string && data.avatarColor.size() >= 3 && data.avatarColor.size() <= 80
        && data.isKids is bool
        && data.favoriteGenres is list && data.favoriteGenres.size() <= 20
        && (data.favoriteGenres.size() == 0 || data.favoriteGenres[0] is string)
        && data.preferredPlatforms is list && data.preferredPlatforms.size() <= 15
        && (data.preferredPlatforms.size() == 0 || data.preferredPlatforms[0] is string)
        && data.watchlist is list && data.watchlist.size() <= 500
        && (data.watchlist.size() == 0 || data.watchlist[0] is string)
        && data.liked is list && data.liked.size() <= 500
        && (data.liked.size() == 0 || data.liked[0] is string)
        && data.disliked is list && data.disliked.size() <= 500
        && (data.disliked.size() == 0 || data.disliked[0] is string)
        && data.watchHistory is list && data.watchHistory.size() <= 200
        && (data.watchHistory.size() == 0 || data.watchHistory[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['activeProfileId', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'activeProfileId', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /profiles/{profileId} {
        allow get: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isVerifiedOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && isValidViewerProfile(incoming(), userId, profileId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && isValidViewerProfile(incoming(), userId, profileId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'avatarColor', 'isKids', 'favoriteGenres', 'preferredPlatforms', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['watchlist', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['liked', 'disliked', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['watchHistory', 'updatedAt'])
          );

        allow delete: if isValidId(userId)
          && isValidId(profileId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
